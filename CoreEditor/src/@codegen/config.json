{
  "parsing": {
    "targets": {
      "config": {
        "source": ["../config.ts"]
      },
      "native": {
        "source": ["../bridge/native/*.ts"]
      },
      "web": {
        "source": ["../bridge/web/*.ts"]
      }
    },
    "predefinedTypes": [
      "CodeGen_Int",
      "CodeGen_UInt64",
      "CodeGen_Self",
      "CodeGen_Dict"
    ],
    "defaultCustomTags": {},
    "dropInterfaceIPrefix": true
  },
  "rendering": {
    "swift": {
      "renders": [
        {
          "target": "config",
          "template": "swift-config.mustache",
          "outputPath": "../../../TraceCore/Sources"
        },
        {
          "target": "native",
          "template": "swift-native-module.mustache",
          "outputPath": "../../../TraceKit/Sources/Bridge/Native/Generated"
        },
        {
          "target": "web",
          "template": "swift-web-module.mustache",
          "outputPath": "../../../TraceKit/Sources/Bridge/Web/Generated"
        }
      ],
      "namedTypesTemplatePath": "swift-shared-types.mustache",
      "namedTypesOutputPath": "../../../TraceCore/Sources/EditorSharedTypes.swift",
      "typeNameMap": {
        "CodeGen_Int": "Int",
        "CodeGen_UInt64": "UInt64",
        "CodeGen_Self": "Self",
        "CodeGen_Dict": "[String: Any]"
      }
    }
  }
}
